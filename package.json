{
  "name": "playlist-affiliates",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:build": "npm run build && node --test tests/build/*.test.mjs",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm test && npm run test:build"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^5.16.0",
    "tailwindcss": "^4.3.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3"
  }
}
