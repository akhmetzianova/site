---
interface Props {
  edition: string;
}

const { edition } = Astro.props;
---

<header class="site-container mb-6 py-0 max-sm:px-0 sm:mb-0 sm:py-6">
  <div class="header-card relative isolate overflow-clip px-4 py-6 text-header-ink sm:rounded-card sm:px-10">
    <h1 id="catalog-title" class="text-[clamp(1.65rem,3.1vw,2.5rem)] leading-[1.2]">
      Лучшие онлайн-казино по отзывам игроков:
      <span class="whitespace-nowrap" data-edition set:text={edition} />
    </h1>
    <p class="mt-3 max-w-[34ch] text-sm leading-[1.55] text-header-muted sm:max-w-none sm:text-base">
      Отзывов обработано: <span id="reviews-count">—</span>
    </p>
  </div>
</header>

<script>
  import { updateEdition } from '@/scripts/update-edition.mjs';

  updateEdition(document);

  const el = document.getElementById('reviews-count');
  function update() {
    const x1 = new Date().getTime();
    const x2 = new Date('2000-01-01').getTime();
    const num = Math.trunc((x1 - x2) / 10 ** 3);
    if (el) el.textContent = num.toLocaleString('ru-RU');
  }
  update();
  setInterval(update, 2500 + Math.random() * 1500);
</script>
